{
  "name": "body-fit",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i assets/css/src.css -o assets/css/app.css --minify",
    "css:watch": "tailwindcss -i assets/css/src.css -o assets/css/app.css --watch",
    "dev": "concurrently -k -n css,serve -c cyan,green \"npm:css:watch\" \"live-server\"",
    "build": "npm run css"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "live-server": "^1.2.2",
    "tailwindcss": "^3.4.19"
  }
}
